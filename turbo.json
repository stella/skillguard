{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["oxlint.config.ts", "bunfig.toml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": []
    },
    "typecheck": {
      "outputs": []
    }
  }
}
